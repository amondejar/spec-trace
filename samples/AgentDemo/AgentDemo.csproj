<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Demo: un agente de Microsoft Agent Framework que usa las herramientas MCP de SpecTrace.
    No forma parte de SpecTrace.sln para que el CI no dependa de un proveedor de modelos.
    Versiones flotantes a propósito: el ecosistema cambia rápido; fíjalas cuando lo adoptes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.*" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.*" />
  </ItemGroup>

</Project>
