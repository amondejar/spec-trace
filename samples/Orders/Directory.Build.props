<Project>
  <!--
    In a real repository all you need is:  <PackageReference Include="SpecTrace" Version="0.7.1-preview.1" />
    Here the sample consumes the analyzer and the code fixes straight from the repository source code.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../src/SpecTrace.Analyzers/build/SpecTrace.props" />

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/SpecTrace.Analyzers/SpecTrace.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Code fixes and refactorings: only used by the IDE (Visual Studio, Rider, VS Code with C# Dev Kit). -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/SpecTrace.CodeFixes/SpecTrace.CodeFixes.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/SpecTrace.Abstractions/SpecTrace.Abstractions.csproj" />
  </ItemGroup>
</Project>
