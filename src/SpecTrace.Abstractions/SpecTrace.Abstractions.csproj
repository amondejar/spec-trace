<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SpecTrace</RootNamespace>
    <PackageId>SpecTrace.Abstractions</PackageId>
    <Description>The [Implements] and [Verifies] attributes that trace Spec-Driven Development requirements to code and tests. Used by the SpecTrace analyzer.</Description>
    <PackageTags>sdd;spec-driven-development;traceability;requirements;attributes</PackageTags>
  </PropertyGroup>

</Project>
