<Project>

  <!--
    Defaults. Override them in the .csproj or in Directory.Build.props:
      SpecTraceRoot       folder containing spectrace.json (searched upwards from the project)
      SpecTraceSpecsDir   folder with the *.spec.md files (default $(SpecTraceRoot)specs/)
      SpecTraceNamespace  namespace of the generated catalog (default $(RootNamespace).Specs)
      SpecTraceRole       Implementation | Tests (default: deduced from IsTestProject)
  -->
  <PropertyGroup>
    <_SpecTraceMarkerDir>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), spectrace.json))</_SpecTraceMarkerDir>
    <SpecTraceRoot Condition="'$(SpecTraceRoot)' == '' and '$(_SpecTraceMarkerDir)' != ''">$(_SpecTraceMarkerDir)/</SpecTraceRoot>
    <SpecTraceRoot Condition="'$(SpecTraceRoot)' == ''">$(MSBuildProjectDirectory)/</SpecTraceRoot>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="IsTestProject" />
    <CompilerVisibleProperty Include="SpecTraceNamespace" />
    <CompilerVisibleProperty Include="SpecTraceRole" />
  </ItemGroup>

</Project>
