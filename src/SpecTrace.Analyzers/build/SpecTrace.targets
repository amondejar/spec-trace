<Project>

  <!-- En .targets para que las propiedades definidas en el .csproj ya estén resueltas. -->
  <PropertyGroup>
    <SpecTraceSpecsDir Condition="'$(SpecTraceSpecsDir)' == ''">$(SpecTraceRoot)specs/</SpecTraceSpecsDir>
  </PropertyGroup>

  <!-- Versión revisada de cada requisito (dotnet spectrace lock): activa ST0010/ST0011. -->
  <ItemGroup Condition="Exists('$(SpecTraceRoot)spectrace.lock')">
    <AdditionalFiles Include="$(SpecTraceRoot)spectrace.lock" Link="specs/spectrace.lock" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(SpecTraceSpecsDir)')">
    <AdditionalFiles Include="$(SpecTraceSpecsDir)**/*.spec.md" Link="specs/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
