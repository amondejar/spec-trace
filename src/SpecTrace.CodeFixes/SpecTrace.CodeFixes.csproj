<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code fixes y refactorizaciones para el IDE. Va en un ensamblado aparte porque depende de
    Microsoft.CodeAnalysis.Workspaces, que el compilador de línea de comandos no carga (RS1038).
    Se empaqueta junto al analizador desde SpecTrace.Package.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SpecTrace.CodeFixes</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpecTrace.Analyzers\SpecTrace.Analyzers.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
