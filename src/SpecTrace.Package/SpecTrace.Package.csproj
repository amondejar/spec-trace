<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The "SpecTrace" NuGet package. It has no code of its own: it puts the analyzer + generator
    (SpecTrace.Analyzers.dll) and the code fixes (SpecTrace.CodeFixes.dll) in analyzers/dotnet/cs,
    adds the MSBuild props/targets and declares the dependency on SpecTrace.Abstractions.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>SpecTrace</PackageId>
    <Description>Spec-Driven Development traceability for .NET. Generates a typed requirements catalog from Markdown specs and reports, at build time, requirements that are not implemented, not tested or changed after review. Includes IDE code fixes. Works with Spec Kit, OpenSpec and AI coding agents.</Description>
    <PackageTags>sdd;spec-driven-development;requirements;traceability;roslyn;analyzer;source-generator;codefix;spec-kit;openspec;ai-agents</PackageTags>
    <DevelopmentDependency>false</DevelopmentDependency>

    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_SpecTraceAddAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's real dependency: the attributes. -->
    <ProjectReference Include="..\SpecTrace.Abstractions\SpecTrace.Abstractions.csproj" />
    <!-- Only copied into analyzers/; not dependencies of the package. -->
    <ProjectReference Include="..\SpecTrace.Analyzers\SpecTrace.Analyzers.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SpecTrace.CodeFixes\SpecTrace.CodeFixes.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\SpecTrace.Analyzers\build\SpecTrace.props" Pack="true" PackagePath="build;buildTransitive" Visible="false" />
    <None Include="..\SpecTrace.Analyzers\build\SpecTrace.targets" Pack="true" PackagePath="build;buildTransitive" Visible="false" />
  </ItemGroup>

  <Target Name="_SpecTraceAddAnalyzers">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)SpecTrace.Analyzers.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)SpecTrace.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
