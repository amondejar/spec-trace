<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SpecTrace.Tool</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>spectrace</ToolCommandName>
    <PackageId>SpecTrace.Tool</PackageId>
    <Description>The SpecTrace CLI (dotnet spectrace): traceability report, spec change review (spectrace.lock), MCP server for AI coding agents, import from Spec Kit and OpenSpec, and xUnit test scaffolding.</Description>
    <PackageTags>sdd;spec-driven-development;requirements;traceability;mcp;model-context-protocol;spec-kit;openspec;ai-agents;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\*.md" />
    <EmbeddedResource Include="Templates\*.yml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec parser and test template shared with the analyzer. -->
    <ProjectReference Include="..\SpecTrace.Analyzers\SpecTrace.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpecTrace.Tests" />
  </ItemGroup>

</Project>
